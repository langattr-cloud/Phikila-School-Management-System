# All VITE_* values are bundled into the browser. Use only the publishable/anon key.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Optional. Omit for same-origin (the frontend and Worker share a domain).
# Set to the Cloudflare Worker URL when the frontend (Vercel) and backend
# (Workers) are on different origins.
# VITE_API_URL=https://phikila-api.YOUR_SUBDOMAIN.workers.dev
