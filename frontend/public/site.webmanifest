{
  "name": "Phikila School Management System",
  "short_name": "Phikila",
  "description": "One place for your school profile, academic years, terms, levels, and streams.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0A1E34",
  "theme_color": "#0F2A47",
  "icons": [
    {
      "src": "/brand/favicon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/brand/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/brand/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/brand/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "categories": [
    "education",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Timetable",
      "short_name": "Timetable",
      "url": "/timetable"
    },
    {
      "name": "My timetable",
      "short_name": "Mine",
      "url": "/my-timetable"
    },
    {
      "name": "Generate",
      "short_name": "Generate",
      "url": "/scheduling/generate"
    }
  ]
}
