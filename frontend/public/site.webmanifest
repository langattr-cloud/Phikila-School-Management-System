{
  "name": "Phikila School Management System",
  "short_name": "Phikila",
  "description": "Smarter school operations, academics and timetables in one platform.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#06111F",
  "theme_color": "#0A1E34",
  "icons": [
    { "src": "/brand/phikila-logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/brand/favicon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/brand/favicon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "categories": ["education", "productivity"],
  "shortcuts": [
    { "name": "Dashboard", "short_name": "Dashboard", "url": "/dashboard" },
    { "name": "Timetable", "short_name": "Timetable", "url": "/timetable" },
    { "name": "My timetable", "short_name": "Mine", "url": "/my-timetable" },
    { "name": "Generate", "short_name": "Generate", "url": "/scheduling/generate" }
  ]
}
