# REQUIRED in Vercel Production. Supabase transaction pooler connection string
# (Project Settings > Database > Connection string > Transaction pooler).
# Use port 6543 with sslmode=require. Do not use the direct IPv6 connection.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Set this explicitly to production in the Vercel Production environment.
ENVIRONMENT=development

# CORS is unnecessary for the single-domain Vercel deployment. These local
# origins are useful only when Vite and FastAPI run on separate local ports.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional only for a deliberately separate trusted frontend. Never use `*`.
# CORS_ORIGIN_REGEX=https://your-trusted-preview-pattern\.vercel\.app

# Project URL, not the REST API URL.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Only required if Supabase Auth still issues legacy HS256 access tokens.
# SUPABASE_JWT_SECRET=

# Optional: enables the legacy /api/v1/auth/login endpoint. The browser app
# signs in through Supabase Auth and does not need this variable.
# APP_JWT_SECRET=generate-a-long-random-value

# ---------------------------------------------------------------------------
# Timetable scheduling (optional)
# ---------------------------------------------------------------------------
# The AI Schedule Copilot works with no key at all: a deterministic rule-based
# parser handles natural-language commands. Set a key ONLY if you want an LLM
# to do the parsing. It is read server-side and is never sent to the browser.
# Never put this in a VITE_* variable.
# OPENAI_API_KEY=
# COPILOT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
