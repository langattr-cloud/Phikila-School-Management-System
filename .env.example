# REQUIRED in production. Supabase transaction pooler connection string
# (Project Settings > Database > Connection string > Transaction pooler).
# Use port 6543 and append sslmode=require. The app fails to boot on Vercel
# without this. Use the pooler, NOT the direct connection (IPv6) string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

ENVIRONMENT=development

# Comma-separated exact frontend origins. Add production and preview domains in Vercel.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Optional regex for one frontend project's Vercel previews (escape dots).
# CORS_ORIGIN_REGEX=https://your-frontend-[a-z0-9-]+\.vercel\.app

# Project URL, not the REST API URL.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Only required if Supabase Auth still uses the legacy HS256 JWT secret.
# SUPABASE_JWT_SECRET=

# Optional: enables the old /api/v1/auth/login endpoint. New clients use Supabase Auth.
# APP_JWT_SECRET=generate-a-long-random-value
