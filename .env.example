# REQUIRED in Vercel Production. Supabase transaction pooler connection string
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional only for a deliberately separate trusted frontend. Never use `*`.
# CORS_ORIGIN_REGEX=https://your-trusted-preview-pattern\\.vercel\\.app

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=
# APP_JWT_SECRET=generate-a-long-random-value

# ---------------------------------------------------------------------------
# Upstash Redis rate limiting — BACKEND / RENDER ONLY
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_RATE_LIMIT_FAIL_OPEN=true

# ---------------------------------------------------------------------------
# Resend Email Integration
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Phikila School System <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Microsoft 365 / Outlook delegated OAuth — BACKEND ONLY
# ---------------------------------------------------------------------------
# Create an Entra ID app registration with delegated Microsoft Graph Mail.Send.
# Register the exact callback URL below as a Web redirect URI.
# Never expose the client secret or encryption key in VITE_* variables.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://phikila.com/api/v1/outlook/callback
MICROSOFT_FRONTEND_REDIRECT=https://phikila.com
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MICROSOFT_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Timetable scheduling (optional)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# COPILOT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# LLM provider credential encryption
# ---------------------------------------------------------------------------
# LLM_ENCRYPTION_KEY=
