{
  "name": "phikila-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "db:link": "supabase link --project-ref xpsazsigjurnmrjibgsn",
    "db:up": "supabase db push",
    "db:migrate": "supabase db reset --linked",
    "db:gen": "supabase gen types typescript --project-id xpsazsigjurnmrjibgsn > src/types/database.gen.ts"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^3.83.0"
  }
}