FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt requirements-solver.txt ./
RUN pip install --no-cache-dir -r requirements-solver.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV SOLVER_DEDICATED_WORKER=1

EXPOSE 8000

# The current Render workspace has the web service but does not provision the
# worker declared in render.yaml. Start the durable DB-backed solver loop in a
# child process so queued jobs are actually claimed while FastAPI serves HTTP.
CMD ["sh", "-c", "alembic upgrade head && python -m app.modules.scheduling.worker & exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
