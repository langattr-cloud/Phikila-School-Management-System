FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt requirements-solver.txt ./
RUN pip install --no-cache-dir -r requirements-solver.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PORT=8000

EXPOSE 8000

# The current Render project has the API service provisioned but not a
# separately provisioned worker service. Start the durable DB-backed solver
# worker alongside the API so queued timetable jobs are actually consumed.
CMD ["sh", "-c", "alembic upgrade head && python -m app.modules.scheduling.worker & exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
