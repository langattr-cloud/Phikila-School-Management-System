FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt requirements-solver.txt ./
RUN pip install --no-cache-dir -r requirements-solver.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV SOLVER_DEDICATED_WORKER=1
ENV LOG_LEVEL=INFO

EXPOSE 8000

# Start the web server immediately so Render can detect the bound port.
# Database migrations are handled by the supervisor after the API is listening.
CMD ["python", "-m", "app.render_entrypoint"]
