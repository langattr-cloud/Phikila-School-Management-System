FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt requirements-solver.txt ./
RUN pip install --no-cache-dir -r requirements-solver.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PORT=8000

EXPOSE 8000

# Keep the Render web service dedicated to FastAPI. The solver worker must
# run as its own Render worker service rather than sharing the web process.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
