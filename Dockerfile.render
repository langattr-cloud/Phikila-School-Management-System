FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV LOG_LEVEL=INFO

EXPOSE 8000

# The supervisor binds the API first, then runs Alembic migrations.
CMD ["python", "-m", "app.render_entrypoint"]
