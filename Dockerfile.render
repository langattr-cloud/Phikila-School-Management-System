FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt requirements-solver.txt ./
RUN pip install --no-cache-dir -r requirements-solver.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PORT=8000
ENV SOLVER_DEDICATED_WORKER=1
ENV LOG_LEVEL=INFO

EXPOSE 8000

# Run the API and solver under one supervisor so Render restarts the worker
# independently if it exits, instead of silently orphaning it behind a shell.
CMD ["sh", "-c", "alembic upgrade head && exec python -m app.render_entrypoint"]
